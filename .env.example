# --- 운영 환경 ---
FLASK_ENV=development
SECRET_KEY=
LOG_LEVEL=INFO

# --- 데모/비식별 ---
# true 시 운영 데이터 로딩 차단, data/demo/ fixture만 사용
DEMO_MODE=true

# --- 외부 API ---
KAKAO_API_KEY=
KMA_API_KEY=
DATA_GO_KR_API_KEY=
NEIS_API_KEY=

# --- AI ---
# claude -p CLI 경로 (PATH 등록되어있으면 'claude')
CLAUDE_CLI_PATH=claude
# 보고서 초안 생성 timeout (초)
AI_DRAFT_TIMEOUT=60
# API 모드로 전환 시 사용 (현 출품판은 미사용)
ANTHROPIC_API_KEY=
