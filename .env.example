# --- 운영 환경 ---
FLASK_ENV=development
SECRET_KEY=
LOG_LEVEL=INFO

# --- 데모/비식별 ---
# true 시 운영 데이터 로딩 차단, data/demo/ fixture만 사용
DEMO_MODE=true

# --- 학교 데이터셋 ---
# DEMO_MODE=false 일 때만 적용
# national: data/processed/schools.json (전국 12,011건)
# ulsan   : data/processed/schools.ulsan.json (울산 245건, 성능/시연용)
SCHOOL_DATASET=national

# --- 지도 제공자 ---
# osm   : OpenStreetMap 타일 (무료, 키 불필요) — 기본
# vworld: VWorld 공공지도 (국토부, 운영키 + 등록 도메인 필요)
MAP_PROVIDER=osm
VWORLD_API_KEY=

# --- 외부 API ---
KAKAO_API_KEY=
KMA_API_KEY=
DATA_GO_KR_API_KEY=
NEIS_API_KEY=

# --- AI ---
# 어댑터 선택: cli | sdk | template
# - cli      : 로컬 개발 (claude -p subprocess)
# - sdk      : Railway 배포 (Anthropic API)
# - template : AI 미사용 결정론 fallback만
AI_DRAFTER=cli

# claude -p CLI 경로 (PATH 등록되어있으면 'claude')
CLAUDE_CLI_PATH=claude
# 보고서 초안 생성 timeout (초)
AI_DRAFT_TIMEOUT=60

# SDK 모드 전용
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048
